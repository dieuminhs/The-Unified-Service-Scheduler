{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Default": "Data Source=scheduler.db"
  },
  "Booking": {
    "MaxRetries": 3,
    "RetryBaseDelayMs": 50,
    "DefaultGranularityMinutes": 15
  },
  "Seeding": {
    "Enabled": false
  },
  "AllowedHosts": "*"
}
